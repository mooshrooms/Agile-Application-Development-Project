{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TestingApp;User=root;Password=your_password;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "your_secret_key_here",
    "Issuer": "TestingApp",
    "Audience": "TestingAppUsers",
    "ExpiryInMinutes": 60
  }
} 